---
---
<header class="navbar">
  <div class="navbar-inner">
    <a href="/" class="logo">
      <img src="https://aleluya.com/wp-content/uploads/2026/04/Copy-of-sin_fondo_letra_negra.png" alt="aleluya" />
    </a>

    <nav class="nav-links">
      <a href="/precios">Precios</a>
      <div class="dropdown">
        <button class="dropdown-btn">
          Recursos
          <svg width="10" height="6" viewBox="0 0 10 6"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
        <div class="dropdown-menu">
          <a href="https://aleluya.com/blog/" target="_blank">Blog</a>
          <a href="https://www.calculadoralaboral.co/" target="_blank">Calculadora laboral</a>
          <a href="https://ayuda.aleluya.com/portal/es/kb" target="_blank">Centro de ayuda</a>
          <a href="https://www.calculadoralaboral.co/retention" target="_blank">Calculadora de retención en la fuente</a>
        </div>
      </div>
    </nav>

    <div class="nav-ctas">
      <a href="https://tranqui.aleluya.com/signup/" class="btn-primary">Empieza gratis</a>
      <a href="https://tranqui.aleluya.com/login" class="btn-ghost">Ingresa</a>
    </div>

    <button class="burger" id="burger" aria-label="Menú">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mobile-nav" id="mobileNav">
    <a href="/precios">Precios</a>
    <a href="https://aleluya.com/blog/" target="_blank">Blog</a>
    <a href="https://www.calculadoralaboral.co/" target="_blank">Calculadora laboral</a>
    <a href="https://ayuda.aleluya.com/portal/es/kb" target="_blank">Centro de ayuda</a>
    <div class="mobile-ctas">
      <a href="https://tranqui.aleluya.com/signup/" class="btn-primary">Empieza gratis</a>
      <a href="https://tranqui.aleluya.com/login" class="btn-ghost">Ingresa</a>
    </div>
  </div>
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #fff;
    border-bottom: 1px solid #f0f0f0;
  }
  .navbar-inner {
    display: flex;
    align-items: center;
    padding: 0 48px;
    height: 64px;
    gap: 32px;
  }
  .logo img { height: 30px; width: auto; display: block; }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
    flex: 1;
  }
  .nav-links a, .dropdown-btn {
    font-size: 15px;
    font-weight: 500;
    color: #1E1E1E;
    text-decoration: none;
    padding: 7px 14px;
    border-radius: 8px;
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
    display: flex;
    align-items: center;
    gap: 5px;
    transition: background .15s;
  }
  .nav-links a:hover, .dropdown-btn:hover { background: #f4f4f4; }

  .dropdown { position: relative; }
  .dropdown-menu {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    background: #fff;
    border: 1px solid #e8e8e8;
    border-radius: 14px;
    padding: 8px;
    min-width: 280px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.1);
    z-index: 200;
  }
  .dropdown-menu a {
    display: block;
    font-size: 14px;
    font-weight: 500;
    color: #1E1E1E;
    text-decoration: none;
    padding: 10px 14px;
    border-radius: 8px;
    transition: background .15s;
  }
  .dropdown-menu a:hover { background: #f4f4f4; }
  .dropdown:hover .dropdown-menu,
  .dropdown:focus-within .dropdown-menu { display: block; }

  .nav-ctas { display: flex; align-items: center; gap: 8px; }
  .btn-primary {
    font-size: 14px;
    font-weight: 700;
    color: #fff;
    background: #5E25FF;
    text-decoration: none;
    padding: 9px 20px;
    border-radius: 100px;
    transition: background .15s;
    white-space: nowrap;
  }
  .btn-primary:hover { background: #4a1be0; }
  .btn-ghost {
    font-size: 14px;
    font-weight: 600;
    color: #1E1E1E;
    text-decoration: none;
    padding: 9px 18px;
    border-radius: 100px;
    border: 1.5px solid #ddd;
    transition: border-color .15s;
    white-space: nowrap;
  }
  .btn-ghost:hover { border-color: #5E25FF; }

  .burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    margin-left: auto;
  }
  .burger span { display: block; width: 22px; height: 2px; background: #1E1E1E; border-radius: 2px; }

  .mobile-nav {
    display: none;
    flex-direction: column;
    padding: 12px 24px 20px;
    border-top: 1px solid #f0f0f0;
    background: #fff;
  }
  .mobile-nav a {
    font-size: 15px;
    font-weight: 500;
    color: #1E1E1E;
    text-decoration: none;
    padding: 12px 0;
    border-bottom: 1px solid #f5f5f5;
  }
  .mobile-ctas { display: flex; gap: 8px; margin-top: 16px; }
  .mobile-ctas a { flex: 1; text-align: center; }
  .mobile-nav.open { display: flex; }

  @media (max-width: 768px) {
    .navbar-inner { padding: 0 20px; }
    .nav-links, .nav-ctas { display: none; }
    .burger { display: flex; }
  }
</style>

<script>
  document.getElementById('burger')?.addEventListener('click', () => {
    document.getElementById('mobileNav')?.classList.toggle('open');
  });
</script>
