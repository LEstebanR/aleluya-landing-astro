---
const logos = [
  { name: "sempl", src: "https://aleluya.com/wp-content/uploads/2025/02/semple-logo.svg" },
  { name: "KiwiBot", src: "https://aleluya.com/wp-content/uploads/2025/02/kiwibot-logo.svg" },
  { name: "Mogo", src: "https://aleluya.com/wp-content/uploads/2025/02/mogo-logo.svg" },
  { name: "PlayVox", src: "https://aleluya.com/wp-content/uploads/2025/02/playvox-logo.svg" },
  { name: "HackU", src: "https://aleluya.com/wp-content/uploads/2025/02/hacku-logo.svg" },
  { name: "B2Chat", src: "https://aleluya.com/wp-content/uploads/2025/02/b2chat-logo.svg" },
  { name: "Ubidots", src: "https://aleluya.com/wp-content/uploads/2025/02/ubidots-logo.svg" },
  { name: "Dynamo", src: "https://aleluya.com/wp-content/uploads/2025/02/icon-dynamo-logo.svg" },
  { name: "Tributi", src: "https://aleluya.com/wp-content/uploads/2025/02/tributi-logo.svg" },
  { name: "TRII", src: "https://aleluya.com/wp-content/uploads/2025/02/trii-logo.svg" },
];
---

<section class="stats-section">
  <div class="stats-cards">
    <div class="stat-card stat-card--lavender">
      <div class="stat-number">+4.500</div>
      <div class="stat-desc">Empresas colombianas confían su nómina en Aleluya.</div>
      <div class="stat-tag">+ Tiempo</div>
    </div>
    <div class="stat-card stat-card--orange">
      <div class="stat-number">+50 mil</div>
      <div class="stat-desc">Empleados procesados cada quincena.</div>
      <div class="stat-tag">+ Tranquilidad</div>
    </div>
    <div class="stat-card stat-card--lavender">
      <div class="stat-number">+3 bill.</div>
      <div class="stat-desc">COP en nómina procesados en 2025.</div>
      <div class="stat-tag">+ Seguridad</div>
    </div>
  </div>

  <div class="logos-marquee-wrap">
    <div class="marquee-track logos-track">
      {logos.map((l) => (
        <div class="logo-item">
          <img src={l.src} alt={l.name} loading="lazy" />
        </div>
      ))}
      {logos.map((l) => (
        <div class="logo-item" aria-hidden="true">
          <img src={l.src} alt="" loading="lazy" />
        </div>
      ))}
    </div>
  </div>

  <p class="stats-bottom">
    <strong>4.500</strong> empresas en colombia ya sacaron su nómina del <strong>Excel.</strong>
  </p>
</section>

<style>
  .stats-section {
    background: #47F8D3;
    padding: 0 0 56px;
  }

  .stats-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    padding: 52px 48px 0;
    min-height: 280px;
  }
  .stat-card--lavender { background: #DDD5FF; }
  .stat-card--orange { background: #E65528; }

  .stat-number {
    font-size: clamp(52px, 7vw, 96px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: #1E1E1E;
    margin-bottom: 20px;
  }

  .stat-desc {
    font-size: 18px;
    font-weight: 500;
    color: #1E1E1E;
    line-height: 1.4;
    flex: 1;
    padding-bottom: 32px;
  }

  .stat-tag {
    background: #1E1E1E;
    color: #fff;
    font-size: 18px;
    font-weight: 700;
    padding: 18px 48px;
    margin: 0 -48px;
    letter-spacing: -0.01em;
  }

  .logos-marquee-wrap {
    overflow: hidden;
    padding: 40px 0;
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }

  .logos-track {
    display: flex;
    align-items: center;
    gap: 56px;
    width: max-content;
  }

  .logo-item img {
    height: 26px;
    width: auto;
    filter: brightness(0);
    opacity: 0.6;
  }

  .stats-bottom {
    text-align: center;
    font-size: 20px;
    color: #1E1E1E;
    padding: 0 24px;
  }
  .stats-bottom strong { font-weight: 800; }

  @media (max-width: 768px) {
    .stats-cards { grid-template-columns: 1fr; }
    .stat-card { min-height: auto; padding: 40px 32px 0; }
    .stat-tag { margin: 0 -32px; padding: 16px 32px; }
  }
</style>
