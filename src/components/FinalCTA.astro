---
---
<section class="final-cta">
  <!-- Geometric decorations -->
  <div class="geo geo-1"></div>
  <div class="geo geo-2"></div>
  <div class="geo geo-3"></div>
  <div class="geo geo-4"></div>
  <div class="geo geo-5"></div>
  <div class="geo geo-6"></div>
  <div class="geo geo-7"></div>
  <div class="geo geo-8"></div>
  <div class="geo geo-9"></div>
  <div class="geo geo-10"></div>
  <div class="geo geo-11"></div>
  <div class="geo geo-12"></div>

  <div class="final-cta-inner">
    <h2 class="final-cta-title">
      La <span class="accent-purple">nómina</span> ya no es <span class="accent-green">tu trabajo.</span>
    </h2>
    <a href="https://tranqui.aleluya.com/signup/" class="final-cta-btn">
      Empieza tus 15 días gratis
    </a>
  </div>
</section>

<style>
  .final-cta {
    background: #fff;
    position: relative;
    overflow: hidden;
    padding: 120px 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 480px;
  }

  .final-cta-inner {
    position: relative;
    z-index: 2;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
  }

  .final-cta-title {
    font-size: clamp(36px, 5vw, 72px);
    font-weight: 800;
    color: #1E1E1E;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .accent-purple { color: #5E25FF; }
  .accent-green  { color: #47F8D3; }

  .final-cta-btn {
    display: inline-flex;
    align-items: center;
    background: #5E25FF;
    color: #fff;
    font-size: 18px;
    font-weight: 700;
    padding: 18px 48px;
    border-radius: 100px;
    text-decoration: none;
    transition: background .15s, transform .1s;
  }
  .final-cta-btn:hover { background: #4a1be0; transform: translateY(-2px); }

  /* Geometric shapes */
  .geo {
    position: absolute;
    pointer-events: none;
  }

  /* Top-left cluster */
  .geo-1 {
    width: 56px; height: 56px;
    border: 5px solid #47F8D3;
    border-radius: 50%;
    top: 60px; left: 80px;
  }
  .geo-2 {
    width: 40px; height: 40px;
    background: #1E1E1E;
    border-radius: 50%;
    top: 70px; left: 150px;
  }
  .geo-3 {
    width: 36px; height: 36px;
    border: 5px solid #E65528;
    border-radius: 50%;
    top: 120px; left: 65px;
  }

  /* Top center */
  .geo-4 {
    width: 60px; height: 60px;
    background: #47F8D3;
    top: 48px; left: 50%;
    transform: translateX(-120px);
  }
  .geo-5 {
    width: 52px; height: 52px;
    background: #FFF28C;
    transform: rotate(45deg);
    top: 44px; left: 50%;
    margin-left: -8px;
  }
  .geo-6 {
    width: 52px; height: 52px;
    background: #1E1E1E;
    top: 48px; left: 50%;
    transform: translateX(72px);
  }

  /* Top right arc */
  .geo-7 {
    width: 120px; height: 120px;
    border: 8px solid #5E25FF;
    border-radius: 50%;
    top: -20px; right: 60px;
    clip-path: inset(50% 0 0 0);
  }
  .geo-8 {
    width: 60px; height: 30px;
    background: #1E1E1E;
    border-radius: 60px 60px 0 0;
    top: 40px; right: 120px;
  }
  .geo-9 {
    width: 60px; height: 30px;
    background: #E65528;
    border-radius: 0 0 60px 60px;
    top: 70px; right: 120px;
  }

  /* Bottom left */
  .geo-10 {
    width: 120px; height: 56px;
    background: #E65528;
    border-radius: 60px;
    bottom: 60px; left: 60px;
    display: flex;
    gap: 0;
    overflow: hidden;
  }
  .geo-10::before, .geo-10::after {
    content: "";
    flex: 1;
    background: #fff;
    border-radius: 50%;
    margin: 8px 6px;
  }

  /* Bottom center */
  .geo-11 {
    width: 60px; height: 60px;
    background: #47F8D3;
    border-radius: 50%;
    bottom: 64px; left: 50%;
    transform: translateX(-80px);
  }
  .geo-12 {
    width: 60px; height: 60px;
    background: #FFF28C;
    bottom: 48px; left: 50%;
    transform: translateX(-8px) rotate(0deg);
    clip-path: polygon(0 100%, 100% 100%, 50% 0);
  }

  @media (max-width: 768px) {
    .final-cta { padding: 80px 24px; min-height: auto; }
    .final-cta-title { font-size: 36px; }
    .geo { display: none; }
  }
</style>
