<section class="final-cta">
  <!-- Top left cluster: rings -->
  <div style="position:absolute;width:120px;height:120px;border:9px solid #E65528;border-radius:50%;top:52px;left:56px;pointer-events:none;"></div>
  <div style="position:absolute;width:88px;height:88px;border:9px solid #47F8D3;border-radius:50%;top:108px;left:148px;pointer-events:none;"></div>
  <div style="position:absolute;width:56px;height:56px;background:#1E1E1E;border-radius:50%;top:56px;left:178px;pointer-events:none;"></div>

  <!-- Top center: teal square + yellow diamond + black square -->
  <div style="position:absolute;width:100px;height:100px;background:#47F8D3;top:48px;left:calc(50% - 168px);pointer-events:none;"></div>
  <div style="position:absolute;width:88px;height:88px;background:#FFF28C;transform:rotate(45deg);top:54px;left:calc(50% - 52px);pointer-events:none;"></div>
  <div style="position:absolute;width:100px;height:100px;background:#1E1E1E;top:48px;left:calc(50% + 68px);pointer-events:none;"></div>

  <!-- Top right: purple arc + stacked half-pills -->
  <div style="position:absolute;width:180px;height:90px;border:10px solid #5E25FF;border-bottom-left-radius:90px;border-bottom-right-radius:90px;border-top:none;top:0;right:72px;pointer-events:none;"></div>
  <div style="position:absolute;width:100px;height:52px;background:#1E1E1E;border-radius:50px 50px 0 0;top:40px;right:168px;pointer-events:none;"></div>
  <div style="position:absolute;width:100px;height:52px;background:#E65528;border-radius:0 0 50px 50px;top:92px;right:168px;pointer-events:none;"></div>

  <!-- Bottom left: OOO orange tube -->
  <div style="position:absolute;width:300px;height:120px;background:#E65528;border-radius:60px;bottom:56px;left:-20px;pointer-events:none;display:flex;align-items:center;justify-content:space-evenly;padding:0 20px;">
    <div style="width:76px;height:76px;background:#fff;border-radius:50%;flex-shrink:0;"></div>
    <div style="width:76px;height:76px;background:#fff;border-radius:50%;flex-shrink:0;"></div>
    <div style="width:76px;height:76px;background:#fff;border-radius:50%;flex-shrink:0;"></div>
  </div>

  <!-- Bottom center -->
  <div style="position:absolute;width:96px;height:96px;background:#47F8D3;border-radius:50%;bottom:68px;left:calc(50% - 112px);pointer-events:none;"></div>
  <div style="position:absolute;width:0;height:0;border-left:56px solid transparent;border-right:56px solid transparent;border-bottom:96px solid #FFF28C;bottom:68px;left:calc(50% + 12px);pointer-events:none;"></div>

  <!-- Bottom right: yellow rectangle -->
  <div style="position:absolute;width:220px;height:220px;background:#FFF28C;bottom:-20px;right:-20px;pointer-events:none;"></div>

  <div class="final-cta-inner">
    <h2 class="final-cta-title">
      La <span class="accent-purple">nómina</span> ya no es <span class="accent-green">tu trabajo.</span>
    </h2>
    <a href="https://tranqui.aleluya.com/signup/" class="final-cta-btn">
      Empieza tus 15 días gratis
    </a>
  </div>
</section>

<style>
  .final-cta {
    background: #fff;
    position: relative;
    overflow: hidden;
    padding: 160px 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 560px;
  }

  .final-cta-inner {
    position: relative;
    z-index: 2;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
  }

  .final-cta-title {
    font-size: clamp(36px, 5vw, 72px);
    font-weight: 800;
    color: #1E1E1E;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .accent-purple { color: #5E25FF; }
  .accent-green  { color: #47F8D3; }

  .final-cta-btn {
    display: inline-flex;
    align-items: center;
    background: #5E25FF;
    color: #fff;
    font-size: 18px;
    font-weight: 700;
    padding: 20px 52px;
    border-radius: 100px;
    text-decoration: none;
    transition: background .15s, transform .1s;
  }
  .final-cta-btn:hover { background: #4a1be0; transform: translateY(-2px); }

  /* OOO tube uses class to take advantage of flex */
  .geo-ooo-wrap {
    position: absolute;
    width: 300px;
    height: 120px;
    background: #E65528;
    border-radius: 60px;
    bottom: 56px;
    left: -20px;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: space-evenly;
    padding: 0 20px;
  }
  .geo-ooo-circle {
    width: 76px;
    height: 76px;
    background: #fff;
    border-radius: 50%;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .final-cta { padding: 80px 24px; min-height: auto; }
    .final-cta-title { font-size: 36px; }
    .final-cta [style] { display: none !important; }
    .geo-ooo-wrap { display: none; }
  }
</style>
