---
const logos = [
  { name: "Tributi", src: "https://aleluya.com/wp-content/uploads/2025/02/tributi-logo.svg" },
  { name: "TRII", src: "https://aleluya.com/wp-content/uploads/2025/02/trii-logo.svg" },
  { name: "Semple", src: "https://aleluya.com/wp-content/uploads/2025/02/semple-logo.svg" },
  { name: "KiwiBot", src: "https://aleluya.com/wp-content/uploads/2025/02/kiwibot-logo.svg" },
  { name: "Mogo", src: "https://aleluya.com/wp-content/uploads/2025/02/mogo-logo.svg" },
  { name: "PlayVox", src: "https://aleluya.com/wp-content/uploads/2025/02/playvox-logo.svg" },
  { name: "HackU", src: "https://aleluya.com/wp-content/uploads/2025/02/hacku-logo.svg" },
  { name: "B2Chat", src: "https://aleluya.com/wp-content/uploads/2025/02/b2chat-logo.svg" },
  { name: "Ubidots", src: "https://aleluya.com/wp-content/uploads/2025/02/ubidots-logo.svg" },
  { name: "Dynamo", src: "https://aleluya.com/wp-content/uploads/2025/02/icon-dynamo-logo.svg" },
];
---

<section class="logos-section">
  <div class="logos-inner">
    <p class="logos-label">Empresas como la tuya ya no pagan nómina a ciegas</p>

    <div class="logos-marquee-wrapper">
      <div class="marquee-track logos-track">
        {logos.map((logo) => (
          <div class="logo-item">
            <img src={logo.src} alt={logo.name} loading="lazy" />
          </div>
        ))}
        {logos.map((logo) => (
          <div class="logo-item" aria-hidden="true">
            <img src={logo.src} alt="" loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .logos-section {
    padding: 48px 0 56px;
    background: #fff;
    border-top: 1px solid #f0f0f0;
    border-bottom: 1px solid #f0f0f0;
  }
  .logos-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .logos-label {
    text-align: center;
    font-size: 14px;
    font-weight: 500;
    color: #999;
    letter-spacing: 0.01em;
    margin-bottom: 32px;
    text-transform: uppercase;
  }
  .logos-marquee-wrapper {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
  }
  .logos-track {
    display: flex;
    align-items: center;
    gap: 56px;
    width: max-content;
  }
  .logo-item {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .logo-item img {
    height: 28px;
    width: auto;
    filter: grayscale(100%) opacity(0.55);
    transition: filter 0.2s;
  }
  .logo-item img:hover {
    filter: grayscale(0%) opacity(1);
  }
</style>
