---
---
<section class="cta-section">
  <div class="cta-decoration-top">
    <img
      src="https://aleluya.com/wp-content/uploads/2025/03/icons-cta-home-top.svg"
      alt=""
      aria-hidden="true"
      class="cta-deco-img"
    />
  </div>

  <div class="cta-inner">
    <h2 class="cta-title">Entender la nómina antes de pagarla.</h2>
    <p class="cta-subtitle">
      15 días gratis. Sin tarjeta de crédito. Cancela cuando quieras.
    </p>
    <div class="cta-actions">
      <a href="https://tranqui.aleluya.com/signup/" class="cta-btn-primary">
        Empieza tus 15 días gratis
      </a>
      <a href="https://app.storylane.io/share/xquhuzquh4zf" target="_blank" class="cta-btn-ghost">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <circle cx="8" cy="8" r="7.5" stroke="currentColor"/>
          <path d="M6.5 5.5L10.5 8L6.5 10.5V5.5Z" fill="currentColor"/>
        </svg>
        Ver demo en 1 min
      </a>
    </div>
    <p class="cta-fine">
      Migramos tus datos en menos de una hora &nbsp;·&nbsp; Soporte en español
    </p>
  </div>

  <div class="cta-decoration-bottom">
    <img
      src="https://aleluya.com/wp-content/uploads/2025/03/icons-cta-home-bottom.svg"
      alt=""
      aria-hidden="true"
      class="cta-deco-img"
    />
  </div>
</section>

<style>
  .cta-section {
    background: #FFF28C;
    overflow: hidden;
    position: relative;
  }
  .cta-decoration-top, .cta-decoration-bottom {
    display: block;
    line-height: 0;
  }
  .cta-deco-img {
    width: 100%;
    height: auto;
    display: block;
  }
  .cta-inner {
    padding: 56px 24px;
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
  }
  .cta-title {
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 800;
    color: #1E1E1E;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-bottom: 16px;
  }
  .cta-subtitle {
    font-size: 18px;
    color: rgba(30, 30, 30, 0.7);
    margin-bottom: 36px;
    line-height: 1.5;
  }
  .cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  .cta-btn-primary {
    display: inline-flex;
    align-items: center;
    background: #5E25FF;
    color: #fff;
    font-size: 15px;
    font-weight: 700;
    padding: 14px 32px;
    border-radius: 100px;
    text-decoration: none;
    transition: background 0.15s, transform 0.1s;
    white-space: nowrap;
  }
  .cta-btn-primary:hover { background: #4a1be0; transform: translateY(-1px); }
  .cta-btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    color: #1E1E1E;
    font-size: 15px;
    font-weight: 600;
    padding: 14px 24px;
    border-radius: 100px;
    border: 2px solid rgba(30, 30, 30, 0.25);
    text-decoration: none;
    transition: border-color 0.15s, transform 0.1s;
    white-space: nowrap;
  }
  .cta-btn-ghost:hover { border-color: #1E1E1E; transform: translateY(-1px); }
  .cta-fine {
    font-size: 13px;
    color: rgba(30, 30, 30, 0.55);
  }
</style>
