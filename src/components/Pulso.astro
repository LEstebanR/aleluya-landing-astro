---
const items = [
  { icon: "🧍", label: "Incapacidades sin reclamar" },
  { icon: "🔍", label: "Hallazgos en tus novedades" },
  { icon: "⚠️", label: "Anomalías antes de pagar" },
  { icon: "⚖️", label: "Pasivos creciendo en silencio" },
];
---

<section class="pulso-section">
  <div class="pulso-inner">
    <div class="pulso-text">
      <h2 class="pulso-title">
        <span class="pulso-accent">Estás dejando plata sobre la mesa.<br />
        Y no lo sabes.</span>
      </h2>
      <p class="pulso-desc">
        Cada quincena, Pulso revisa tu nómina y te muestra dónde se te está escapando la plata.
      </p>
      <ul class="pulso-list">
        {items.map((item) => (
          <li class="pulso-item">
            <span class="pulso-icon">{item.icon}</span>
            <span class="pulso-label">{item.label}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="pulso-media">
      <img
        src="https://aleluya.com/wp-content/uploads/2026/05/001-aleluya.png"
        alt="Pulso — análisis de nómina en tiempo real"
        loading="lazy"
        class="pulso-img"
      />
    </div>
  </div>
</section>

<style>
  .pulso-section {
    background: #fff;
    padding: 96px 80px;
    border-top: 1px solid #f0f0f0;
  }
  .pulso-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 80px;
    align-items: center;
  }

  .pulso-title {
    font-size: clamp(32px, 3.5vw, 52px);
    font-weight: 800;
    color: #1E1E1E;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 20px;
  }
  .pulso-accent { color: #5E25FF; }

  .pulso-desc {
    font-size: 17px;
    color: #555;
    line-height: 1.65;
    margin-bottom: 40px;
    max-width: 440px;
  }

  .pulso-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .pulso-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 0;
    border-bottom: 1px solid #eee;
    font-size: 18px;
    font-weight: 600;
    color: #1E1E1E;
  }
  .pulso-item:first-child { border-top: 1px solid #eee; }

  .pulso-icon { font-size: 24px; flex-shrink: 0; }

  .pulso-media {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pulso-img {
    width: 100%;
    height: auto;
    border-radius: 16px;
    box-shadow: 0 16px 48px rgba(0,0,0,0.1);
  }

  @media (max-width: 900px) {
    .pulso-section { padding: 64px 24px; }
    .pulso-inner { grid-template-columns: 1fr; gap: 48px; }
  }
</style>
