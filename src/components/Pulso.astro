---
const items = [
  { icon: "🧍", label: "Incapacidades sin reclamar" },
  { icon: "🔍", label: "Hallazgos en tus novedades" },
  { icon: "⚠️", label: "Anomalías antes de pagar" },
  { icon: "⚖️", label: "Pasivos creciendo en silencio" },
];
---

<section class="pulso-section">
  <div class="pulso-inner">
    <div class="pulso-text">
      <div class="pulso-pill">
        <span class="pulso-dot"></span>
        Pulso
      </div>
      <h2 class="pulso-title">
        Estás dejando plata sobre la mesa.
      </h2>
      <p class="pulso-subtitle">
        Cada quincena, Pulso revisa tu nómina y te muestra dónde se te está escapando la plata.
      </p>
      <ul class="pulso-items">
        {items.map((item) => (
          <li>
            <span class="pulso-icon">{item.icon}</span>
            <span>{item.label}</span>
          </li>
        ))}
      </ul>
      <a href="https://tranqui.aleluya.com/signup/" class="btn-primary-dark">
        Ver cómo funciona Pulso
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M3 8H13M9 4L13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <div class="pulso-image">
      <img
        src="https://aleluya.com/wp-content/uploads/2025/06/aleluya-liquidacion-nomina-nomina-x2-1024x821.webp"
        alt="Pulso - análisis de nómina"
        loading="lazy"
      />
    </div>
  </div>
</section>

<style>
  .pulso-section {
    padding: 80px 24px;
    background: #1E1E1E;
    overflow: hidden;
  }
  .pulso-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }
  .pulso-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 700;
    color: #47F8D3;
    background: rgba(71, 248, 211, 0.1);
    border: 1px solid rgba(71, 248, 211, 0.3);
    padding: 6px 14px;
    border-radius: 100px;
    margin-bottom: 24px;
  }
  .pulso-dot {
    width: 7px;
    height: 7px;
    background: #47F8D3;
    border-radius: 50%;
  }
  .pulso-title {
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 800;
    color: #fff;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 16px;
  }
  .pulso-subtitle {
    font-size: 17px;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.65;
    margin-bottom: 32px;
    max-width: 480px;
  }
  .pulso-items {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 40px;
  }
  .pulso-items li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 15px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 14px 18px;
    border-radius: 12px;
    transition: background 0.15s;
  }
  .pulso-items li:hover { background: rgba(255, 255, 255, 0.12); }
  .pulso-icon { font-size: 20px; flex-shrink: 0; }
  .btn-primary-dark {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #47F8D3;
    color: #1E1E1E;
    font-size: 14px;
    font-weight: 700;
    padding: 13px 24px;
    border-radius: 100px;
    text-decoration: none;
    transition: background 0.15s, transform 0.1s;
  }
  .btn-primary-dark:hover { background: #2de8c2; transform: translateY(-1px); }
  .pulso-image {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .pulso-image img {
    width: 100%;
    max-width: 520px;
    height: auto;
    border-radius: 16px;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.4);
  }

  @media (max-width: 900px) {
    .pulso-inner { grid-template-columns: 1fr; gap: 40px; }
    .pulso-image img { max-width: 100%; }
  }
</style>
