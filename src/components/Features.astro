---
const features = [
  {
    label: "Liquidación",
    title: "Liquidas la nómina sin ser experto.",
    accent: "sin errores ni enredos",
    desc: "Horas extras, vacaciones, prestaciones, liquidaciones laborales, etc. Aleluya liquida todo automáticamente con las reglas de nómina colombiana siempre al día.",
    img: "https://aleluya.com/wp-content/uploads/2025/06/aleluya-liquidacion-nomina-nomina-x2-1024x821.webp",
    imgAlt: "Pantalla de liquidación de nómina Aleluya",
    soon: false,
    reverse: false,
  },
  {
    label: "Autogestión",
    title: "Tus empleados se gestionan solos por",
    accent: "WhatsApp.",
    desc: "Piden vacaciones, descargan certificados laborales y cargan incapacidades desde su celular. Tú solo apruebas.",
    img: "https://aleluya.com/wp-content/uploads/2026/05/021-aleluya@72x.png",
    imgAlt: "Colillas de pago por WhatsApp",
    soon: true,
    reverse: true,
  },
  {
    label: "Seguridad social",
    title: "Pagas la PILA",
    accent: "sin salir de Aleluya.",
    desc: "Integración nativa con Aportes en Línea y Enlace Operativo, los dos operadores más grandes de Colombia.",
    img: "https://aleluya.com/wp-content/uploads/2026/05/041.png",
    imgAlt: "Pago de seguridad social desde Aleluya",
    soon: true,
    reverse: false,
  },
  {
    label: "Nómina electrónica",
    title: "Emites nómina electrónica",
    accent: "a la DIAN.",
    desc: "Firmada y transmitida desde Aleluya. Sin abrir el portal de la DIAN. Transmisiones ilimitadas.",
    img: "https://aleluya.com/wp-content/uploads/2026/05/011-aleluya.png",
    imgAlt: "Nómina electrónica a la DIAN",
    soon: false,
    reverse: true,
  },
  {
    label: "Pagos a empleados",
    title: "Pagas a tus empleados",
    accent: "desde Aleluya.",
    desc: "Integración nativa con Banco de Bogotá. Para cualquier otro banco, generamos la interfaz lista para cargar.",
    img: "https://aleluya.com/wp-content/uploads/2026/05/bancos.png",
    imgAlt: "Pagos a empleados desde Aleluya",
    soon: true,
    reverse: false,
  },
];
---

<section class="features-section">
  {features.map((f) => (
    <div class={`feature-row${f.reverse ? " feature-row--reverse" : ""}`}>
      <div class="feature-text">
        <span class="feature-label">{f.label}</span>
        <h2 class="feature-title">
          {f.title} <span class="feature-accent">{f.accent}</span>
        </h2>
        <p class="feature-desc">{f.desc}</p>
        {f.soon && (
          <span class="feature-soon">Disponible muy pronto</span>
        )}
      </div>
      <div class="feature-media">
        <img src={f.img} alt={f.imgAlt} loading="lazy" class="feature-img" />
      </div>
    </div>
  ))}
</section>

<style>
  .features-section {
    background: #fff;
    display: flex;
    flex-direction: column;
  }

  .feature-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    padding: 80px 80px;
    gap: 80px;
    border-bottom: 1px solid #f0f0f0;
    max-width: 1440px;
    margin: 0 auto;
    width: 100%;
  }
  .feature-row--reverse { direction: rtl; }
  .feature-row--reverse > * { direction: ltr; }

  .feature-label {
    display: block;
    font-size: 13px;
    font-weight: 700;
    color: #5E25FF;
    letter-spacing: 0.01em;
    margin-bottom: 12px;
  }

  .feature-title {
    font-size: clamp(28px, 3vw, 44px);
    font-weight: 800;
    color: #1E1E1E;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 20px;
  }
  .feature-accent { color: #5E25FF; }

  .feature-desc {
    font-size: 17px;
    color: #555;
    line-height: 1.65;
    margin-bottom: 24px;
    max-width: 440px;
  }

  .feature-soon {
    display: inline-block;
    font-size: 13px;
    font-weight: 600;
    color: #5E25FF;
    border: 1.5px solid #c4b5fd;
    border-radius: 100px;
    padding: 6px 16px;
    background: #faf8ff;
  }

  .feature-media {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f9f8ff;
    border-radius: 20px;
    padding: 32px;
    min-height: 380px;
  }

  .feature-img {
    width: 100%;
    max-width: 460px;
    height: auto;
    object-fit: contain;
  }

  @media (max-width: 1024px) {
    .feature-row { padding: 64px 40px; gap: 48px; }
  }

  @media (max-width: 768px) {
    .feature-row,
    .feature-row--reverse {
      grid-template-columns: 1fr;
      direction: ltr;
      padding: 48px 24px;
      gap: 32px;
    }
    .feature-media { min-height: 260px; }
  }
</style>
