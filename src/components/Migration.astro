---
const steps = [
  { num: "01", title: "Configuración inicial", desc: "Datos de tu empresa, empleados y estructura de nómina." },
  { num: "02", title: "Carga masiva de información", desc: "Importa tu historial desde Excel en minutos." },
  { num: "03", title: "Liquidación de nómina", desc: "Tu primera nómina lista para aprobar." },
  { num: "04", title: "Procesos contables y cierre", desc: "Contabilidad, PILA y nómina electrónica integrados." },
];
---

<section class="migration-section">
  <div class="migration-inner">
    <div class="migration-header">
      <p class="migration-eyebrow">Migración</p>
      <h2 class="migration-title">De la configuración al cierre</h2>
      <p class="migration-subtitle">
        En menos de una hora tenés tu empresa lista en Aleluya. Te ayudamos a migrar tus datos sin perder nada.
      </p>
    </div>

    <div class="migration-steps">
      {steps.map((step, i) => (
        <div class="migration-step">
          <div class="step-num">{step.num}</div>
          {i < steps.length - 1 && <div class="step-arrow">→</div>}
          <h3 class="step-title">{step.title}</h3>
          <p class="step-desc">{step.desc}</p>
        </div>
      ))}
    </div>

    <div class="migration-image">
      <img
        src="https://aleluya.com/wp-content/uploads/2026/05/Group-1171276236.png"
        alt="Proceso de migración a Aleluya"
        loading="lazy"
      />
    </div>

    <div class="migration-cta-wrap">
      <p class="migration-cta-text">¿Tienes dudas sobre la migración?</p>
      <a href="https://tranqui.aleluya.com/signup/" class="migration-cta-btn">
        Empieza gratis — migramos tus datos
      </a>
    </div>
  </div>
</section>

<style>
  .migration-section {
    padding: 80px 24px;
    background: #fff;
    border-top: 1px solid #f0f0f0;
  }
  .migration-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .migration-header {
    text-align: center;
    margin-bottom: 56px;
  }
  .migration-eyebrow {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #5E25FF;
    margin-bottom: 12px;
  }
  .migration-title {
    font-size: clamp(28px, 3.5vw, 40px);
    font-weight: 800;
    color: #1E1E1E;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
  }
  .migration-subtitle {
    font-size: 17px;
    color: #666;
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.6;
  }
  .migration-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    margin-bottom: 48px;
    position: relative;
  }
  .migration-step {
    padding: 24px;
    text-align: center;
    position: relative;
  }
  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: #5E25FF;
    color: #fff;
    font-size: 14px;
    font-weight: 800;
    border-radius: 50%;
    margin: 0 auto 16px;
  }
  .step-arrow {
    display: none;
  }
  .step-title {
    font-size: 15px;
    font-weight: 700;
    color: #1E1E1E;
    margin-bottom: 8px;
  }
  .step-desc {
    font-size: 13px;
    color: #777;
    line-height: 1.5;
  }
  .migration-steps::before {
    content: "";
    position: absolute;
    top: 48px;
    left: 12.5%;
    right: 12.5%;
    height: 2px;
    background: linear-gradient(to right, #5E25FF, #47F8D3);
    z-index: 0;
  }
  .migration-image {
    margin-bottom: 48px;
  }
  .migration-image img {
    width: 100%;
    height: auto;
    border-radius: 16px;
    display: block;
  }
  .migration-cta-wrap {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .migration-cta-text {
    font-size: 16px;
    color: #666;
  }
  .migration-cta-btn {
    display: inline-flex;
    align-items: center;
    background: #5E25FF;
    color: #fff;
    font-size: 15px;
    font-weight: 700;
    padding: 14px 32px;
    border-radius: 100px;
    text-decoration: none;
    transition: background 0.15s, transform 0.1s;
  }
  .migration-cta-btn:hover { background: #4a1be0; transform: translateY(-1px); }

  @media (max-width: 768px) {
    .migration-steps {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
    .migration-steps::before { display: none; }
  }
  @media (max-width: 480px) {
    .migration-steps { grid-template-columns: 1fr; }
  }
</style>
