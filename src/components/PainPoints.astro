---
const pains = [
  {
    img: "https://aleluya.com/wp-content/uploads/2026/05/Rectangle-2.png",
    title: "Te roba el tiempo del negocio.",
    desc: "Dos días al mes peleando con fórmulas en una hoja de cálculo. Tiempo que no estás vendiendo, ni cobrando, ni creciendo.",
  },
  {
    img: "https://aleluya.com/wp-content/uploads/2026/05/Rectangle-1.png",
    title: "Te pone en riesgo con la ley.",
    desc: "Un recargo mal calculado, una incapacidad mal liquidada, una PILA tarde. La DIAN y la UGPP no perdonan.",
  },
  {
    img: "https://aleluya.com/wp-content/uploads/2026/05/Rectangle.png",
    title: "Te deja por fuera de la era de la IA.",
    desc: "Otros dueños ya están usando IA para tener equipos más livianos y márgenes más sanos. Tú sigues cuadrando fórmulas a mano.",
  },
];
---

<section class="pain-section">
  <div class="pain-inner">
    <h2 class="pain-title">
      Tu <span class="accent">negocio</span> ya vive en 2026.<br />
      Tu <span class="accent">nómina</span> sigue en los <span class="accent">noventa.</span>
    </h2>

    <div class="pain-grid">
      {pains.map((p) => (
        <div class="pain-card">
          <div class="pain-icon">
            <img src={p.img} alt={p.title} loading="lazy" />
          </div>
          <h3>{p.title}</h3>
          <p>{p.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .pain-section {
    background: #fff;
    padding: 96px 80px;
  }
  .pain-inner { max-width: 1200px; margin: 0 auto; }

  .pain-title {
    font-size: clamp(36px, 4.5vw, 60px);
    font-weight: 800;
    color: #1E1E1E;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 64px;
  }
  .accent { color: #5E25FF; }

  .pain-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
  }

  .pain-card { display: flex; flex-direction: column; gap: 16px; }

  .pain-icon {
    width: 160px;
    height: 160px;
    margin-bottom: 8px;
  }
  .pain-icon img { width: 100%; height: 100%; object-fit: contain; }

  .pain-card h3 {
    font-size: 22px;
    font-weight: 800;
    color: #1E1E1E;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  .pain-card p { font-size: 15px; color: #666; line-height: 1.65; }

  @media (max-width: 900px) {
    .pain-section { padding: 64px 24px; }
    .pain-grid { grid-template-columns: 1fr; gap: 40px; max-width: 480px; }
  }
</style>
