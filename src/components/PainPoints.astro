---
const points = [
  {
    img: "https://aleluya.com/wp-content/uploads/2026/05/Rectangle-1.png",
    title: "2 días al mes en fórmulas de Excel",
    desc: "Cada quincena, calculando horas extras, ausentismos y novedades a mano. Un error y reprocesas todo.",
  },
  {
    img: "https://aleluya.com/wp-content/uploads/2026/05/Rectangle.png",
    title: "Sin saber si estás pagando bien",
    desc: "¿Cuánto te está costando realmente cada empleado? ¿Estás dejando incapacidades sin reclamar? Nadie te avisa.",
  },
  {
    img: "https://aleluya.com/wp-content/uploads/2026/05/Rectangle-2.png",
    title: "Dependiente de un contador para todo",
    desc: "Coordinaciones de ida y vuelta, archivos por WhatsApp, y aun así la PILA llega tarde.",
  },
];
---

<section class="pain-section">
  <div class="pain-inner">
    <div class="pain-header">
      <p class="pain-eyebrow">El problema</p>
      <h2 class="pain-title">¿Por qué sigues pagando nómina a ciegas?</h2>
      <p class="pain-subtitle">
        La mayoría de empresas colombianas liquidan nómina como hace 20 años. Hay una mejor forma.
      </p>
    </div>

    <div class="pain-grid">
      {points.map((p) => (
        <div class="pain-card">
          <div class="pain-card-img-wrap">
            <img src={p.img} alt={p.title} loading="lazy" />
          </div>
          <h3>{p.title}</h3>
          <p>{p.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .pain-section {
    padding: 80px 24px;
    background: #f9f8ff;
  }
  .pain-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .pain-header {
    text-align: center;
    margin-bottom: 56px;
  }
  .pain-eyebrow {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #5E25FF;
    margin-bottom: 12px;
  }
  .pain-title {
    font-size: clamp(28px, 3.5vw, 40px);
    font-weight: 800;
    color: #1E1E1E;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
  }
  .pain-subtitle {
    font-size: 17px;
    color: #666;
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.6;
  }
  .pain-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .pain-card {
    background: #fff;
    border-radius: 20px;
    padding: 32px 28px;
    border: 1px solid #ede8ff;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .pain-card:hover {
    box-shadow: 0 8px 32px rgba(94, 37, 255, 0.1);
    transform: translateY(-3px);
  }
  .pain-card-img-wrap {
    height: 120px;
    display: flex;
    align-items: center;
    margin-bottom: 24px;
  }
  .pain-card-img-wrap img {
    height: 100%;
    width: auto;
    object-fit: contain;
  }
  .pain-card h3 {
    font-size: 18px;
    font-weight: 700;
    color: #1E1E1E;
    margin-bottom: 10px;
    line-height: 1.35;
  }
  .pain-card p {
    font-size: 14px;
    color: #777;
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .pain-grid { grid-template-columns: 1fr; max-width: 480px; margin: 0 auto; }
  }
  @media (max-width: 600px) {
    .pain-section { padding: 56px 24px; }
    .pain-grid { grid-template-columns: 1fr; }
  }
</style>
