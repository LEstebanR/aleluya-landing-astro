      </div>

      <div class="footer-links-grid">
        <div class="footer-col">
          <h4>Recursos</h4>
          <ul>
            <li><a href="https://aleluya.com/blog/" target="_blank">Blog</a></li>
            <li><a href="https://ayuda.aleluya.com/portal/es/" target="_blank">Centro de ayuda</a></li>
