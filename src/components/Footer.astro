<footer class="footer">
  <div class="footer-main">
    <div class="footer-brand">
      <a href="/">
        <img
          src="https://aleluya.com/wp-content/uploads/2026/04/Copy-of-sin_fondo_letra_negra.png"
          alt="aleluya"
          class="footer-logo"
        />
      </a>
      <p class="footer-tagline">Entender la nómina<br />antes de pagarla<span class="dot">.</span></p>
      <p class="footer-redes-label">SEAMOS AMIS EN REDES</p>
      <div class="footer-socials">
        <a href="https://www.linkedin.com/company/aleluya/" target="_blank" aria-label="LinkedIn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>
        </a>
        <a href="https://www.youtube.com/@aleluya_co" target="_blank" aria-label="YouTube">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M22.54 6.42a2.78 2.78 0 00-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 001.46 6.42 29 29 0 001 12a29 29 0 00.46 5.58 2.78 2.78 0 001.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 001.95-1.96A29 29 0 0023 12a29 29 0 00-.46-5.58zM9.75 15.02V8.98L15.5 12l-5.75 3.02z"/></svg>
        </a>
        <a href="https://www.instagram.com/aleluya.co/" target="_blank" aria-label="Instagram">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
        <a href="https://www.facebook.com/aleluya.co/" target="_blank" aria-label="Facebook">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
        </a>
      </div>
    </div>

    <div class="footer-col">
      <p class="col-label">RECURSOS</p>
      <a href="https://aleluya.com/blog/" target="_blank">Blog</a>
      <a href="https://ayuda.aleluya.com/portal/es/" target="_blank">Centro de ayuda</a>
      <a href="https://www.calculadoralaboral.co/" target="_blank">Calculadora Laboral</a>
      <a href="https://www.calculadoralaboral.co/retention" target="_blank">Calculadora de Retención en la Fuente</a>
    </div>

    <div class="footer-col">
      <p class="col-label">EMPRESA</p>
      <a href="https://aleluya.com/trabaja-con-aleluya/" target="_blank">Trabaja con Aleluya</a>
    </div>

    <div class="footer-col">
      <p class="col-label">HABLEMOS!</p>
      <a href="mailto:soporte@aleluya.com" class="footer-email">soporte@aleluya.com</a>
    </div>

    <div class="footer-badges">
      <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/e/e5/DIAN_Colombia.svg/200px-DIAN_Colombia.svg.png" alt="DIAN" class="badge-img" />
      <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/4/48/Logo_de_la_UGPP.svg/200px-Logo_de_la_UGPP.svg.png" alt="UGPP" class="badge-img" />
    </div>
  </div>

  <div class="footer-bottom">
    <p>© {new Date().getFullYear()} Hecho con ❤️ en Colombia</p>
    <div class="footer-legal">
      <a href="https://aleluya.com/terminos-y-condiciones/" target="_blank">Términos y condiciones</a>
      <a href="https://aleluya.com/politica-tratamiento-datos/" target="_blank">Política de tratamiento de datos personales</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #FFF8CC;
  }

  .footer-main {
    display: grid;
    grid-template-columns: 260px 1fr 1fr 1fr auto;
    gap: 40px;
    padding: 80px 80px 48px;
    align-items: start;
    max-width: 1440px;
    margin: 0 auto;
  }

  .footer-logo { height: 28px; width: auto; display: block; margin-bottom: 16px; }

  .footer-tagline {
    font-size: 22px;
    font-weight: 800;
    color: #1E1E1E;
    line-height: 1.3;
    margin-bottom: 24px;
    letter-spacing: -0.02em;
  }
  .dot { color: #E65528; }

  .footer-redes-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #999;
    margin-bottom: 12px;
  }

  .footer-socials { display: flex; gap: 10px; }
  .footer-socials a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: rgba(0,0,0,0.07);
    color: #1E1E1E;
    text-decoration: none;
    transition: background .15s;
  }
  .footer-socials a:hover { background: rgba(0,0,0,0.13); }

  .footer-col { display: flex; flex-direction: column; gap: 12px; }

  .col-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #999;
    margin-bottom: 4px;
  }

  .footer-col a {
    font-size: 15px;
    font-weight: 500;
    color: #1E1E1E;
    text-decoration: none;
    transition: opacity .15s;
    line-height: 1.4;
  }
  .footer-col a:hover { opacity: 0.6; }

  .footer-email {
    font-size: 16px !important;
    font-weight: 700 !important;
    color: #E65528 !important;
  }

  .footer-badges {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
    padding-top: 32px;
  }
  .badge-img { height: 28px; width: auto; opacity: 0.6; filter: grayscale(1); }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 80px;
    border-top: 1px solid rgba(0,0,0,0.08);
    font-size: 13px;
    color: #888;
    background: #fff;
    flex-wrap: wrap;
    gap: 12px;
  }
  .footer-legal { display: flex; gap: 24px; }
  .footer-legal a {
    font-size: 13px;
    color: #888;
    text-decoration: none;
    transition: color .15s;
  }
  .footer-legal a:hover { color: #1E1E1E; }

  @media (max-width: 1024px) {
    .footer-main { grid-template-columns: 1fr 1fr 1fr; gap: 32px; padding: 56px 40px 40px; }
    .footer-badges { padding-top: 0; }
  }
  @media (max-width: 640px) {
    .footer-main { grid-template-columns: 1fr 1fr; padding: 48px 24px 32px; }
    .footer-brand { grid-column: span 2; }
    .footer-bottom { padding: 16px 24px; flex-direction: column; text-align: center; }
    .footer-legal { flex-direction: column; gap: 8px; align-items: center; }
  }
</style>
