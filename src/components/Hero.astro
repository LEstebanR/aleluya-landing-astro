---
---
<section class="hero">
  <!-- Purple swirl decoration -->
  <div class="hero-swirl" aria-hidden="true"></div>

  <div class="hero-layout">
    <div class="hero-text">
      <p class="hero-eyebrow">Software de nómina &nbsp;·&nbsp; 4.500 empresas colombianas</p>

      <h1 class="hero-title">
        La nómina que se opera sola. Y te muestra donde se está yendo la plata.
      </h1>

      <p class="hero-sub">
        No montaste tu empresa para liquidar nómina. Aleluya la hace por ti.
      </p>

      <div class="hero-ctas">
        <a href="https://tranqui.aleluya.com/signup/" class="cta-main">
          Empieza tus 15 días gratis
        </a>
        <p class="cta-fine">Sin tarjeta de crédito</p>
        <a href="https://app.storylane.io/share/xquhuzquh4zf" target="_blank" class="cta-demo">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <circle cx="8" cy="8" r="7.5" stroke="currentColor"/>
            <path d="M6.5 5.5L10.5 8L6.5 10.5V5.5Z" fill="currentColor"/>
          </svg>
          Ver demo en 1 min
        </a>
      </div>
    </div>

    <div class="hero-img-wrap">
      <img
        src="https://aleluya.com/wp-content/uploads/2025/10/aleluya-banner-mujer-sentada.webp"
        alt="Empresaria relajada usando Aleluya"
        class="hero-img"
      />
    </div>
  </div>

  <!-- App video below hero text -->
  <div class="hero-app">
    <div class="hero-video-wrap" style="position:relative;width:100%;padding-top:56.25%;border-radius:16px 16px 0 0;overflow:hidden;box-shadow:0 -8px 40px rgba(94,37,255,0.10);">
      <iframe
        src="https://player.vimeo.com/video/1067041022?color&autopause=0&loop=1&muted=1&title=0&portrait=0&byline=0&h=d10f93def1"
        allow="autoplay; fullscreen; picture-in-picture"
        allowfullscreen
        style="position:absolute;top:0;left:0;width:100%;height:100%;border:none;"
        title="Aleluya — plataforma de nómina"
      ></iframe>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: #fff;
    overflow: hidden;
    padding-bottom: 0;
  }

  /* Purple decorative swirl */
  .hero-swirl {
    position: absolute;
    top: -60px;
    right: -60px;
    width: 680px;
    height: 680px;
    background: radial-gradient(ellipse at center, #c4b5fd 0%, #ddd6fe 40%, transparent 70%);
    border-radius: 50%;
    opacity: 0.55;
    pointer-events: none;
  }

  .hero-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    min-height: calc(100vh - 64px);
    padding: 72px 80px 0;
    gap: 0;
    position: relative;
    z-index: 1;
    max-width: 1440px;
    margin: 0 auto;
  }

  .hero-eyebrow {
    font-size: 13px;
    font-weight: 500;
    color: #666;
    margin-bottom: 20px;
    letter-spacing: 0.01em;
  }

  .hero-title {
    font-size: clamp(40px, 4.8vw, 64px);
    font-weight: 800;
    line-height: 1.08;
    color: #1E1E1E;
    letter-spacing: -0.03em;
    margin-bottom: 20px;
    max-width: 540px;
  }

  .hero-sub {
    font-size: 18px;
    color: #555;
    line-height: 1.55;
    margin-bottom: 36px;
    max-width: 420px;
  }

  .hero-ctas {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }

  .cta-main {
    display: inline-flex;
    align-items: center;
    background: #5E25FF;
    color: #fff;
    font-size: 16px;
    font-weight: 700;
    padding: 15px 32px;
    border-radius: 100px;
    text-decoration: none;
    transition: background .15s, transform .1s;
  }
  .cta-main:hover { background: #4a1be0; transform: translateY(-1px); }

  .cta-fine {
    font-size: 12px;
    color: #aaa;
    padding-left: 4px;
    margin-bottom: 8px;
  }

  .cta-demo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #1E1E1E;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    padding: 12px 4px;
    transition: opacity .15s;
  }
  .cta-demo:hover { opacity: 0.7; }

  .hero-img-wrap {
    display: flex;
    justify-content: flex-end;
    align-items: flex-end;
    position: relative;
    align-self: stretch;
  }

  .hero-img {
    width: auto;
    height: 100%;
    max-height: 800px;
    min-height: 500px;
    object-fit: contain;
    object-position: bottom right;
    position: relative;
    z-index: 1;
  }

  /* App video strip */
  .hero-app {
    position: relative;
    z-index: 1;
    padding: 0 80px 0;
    max-width: 1440px;
    margin: 0 auto;
  }

  .hero-video-wrap {
    position: relative;
    width: 100%;
    padding-top: 56.25%;
    border-radius: 16px 16px 0 0;
    overflow: hidden;
    box-shadow: 0 -8px 40px rgba(94,37,255,0.10);
  }

  .hero-video {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  @media (max-width: 1024px) {
    .hero-layout { padding: 56px 40px 0; min-height: auto; }
    .hero-img-wrap { min-height: auto; }
    .hero-app { padding: 0 40px; }
  }

  @media (max-width: 768px) {
    .hero-layout {
      grid-template-columns: 1fr;
      padding: 40px 24px 32px;
      text-align: left;
    }
    .hero-img-wrap { order: -1; min-height: 280px; height: 280px; justify-content: center; margin-bottom: 32px; }
    .hero-img { max-height: 280px; object-position: center; }
    .hero-title { font-size: 36px; }
    .hero-app { padding: 0 24px; }
  }
</style>
