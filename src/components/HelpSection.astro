---
const cards = [
  {
    icon: "https://aleluya.com/wp-content/uploads/2025/02/icono-compara-aleluya-2.png",
    title: "Compara Aleluya",
    desc: "Conoce qué hace diferente a Aleluya vs todos los demás.",
    cta: "Comparar Aleluya",
    href: "https://aleluya.com/precios/",
  },
  {
    icon: "https://aleluya.com/wp-content/uploads/2025/02/icono-tour-aleluya.png",
    title: "Haz un tour por Aleluya ahora",
    desc: "Enamórate de todo lo que podemos hacer por ti.",
    cta: "Ver demo",
    href: "https://app.storylane.io/share/xquhuzquh4zf",
  },
  {
    icon: "https://aleluya.com/wp-content/uploads/2025/02/icono-centro-de-ayuda-2.png",
    title: "Conoce nuestro centro de ayuda",
    desc: "Da una vuelta y mira lo fácil que es usar Aleluya.",
    cta: "Ver centro de ayuda",
    href: "https://ayuda.aleluya.com/portal/es/kb",
  },
];
---

<section class="help-section">
  <div class="help-inner">
    <h2 class="help-title">¿Tienes preguntas?<br />tenemos respuestas</h2>
    <div class="help-grid">
      {cards.map((c) => (
        <div class="help-card">
          <img src={c.icon} alt={c.title} loading="lazy" class="help-icon" />
          <h3 class="help-card-title">{c.title}</h3>
          <p class="help-card-desc">{c.desc}</p>
          <a href={c.href} target="_blank" class="help-link">
            {c.cta}
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path d="M2.5 7H11.5M8 3.5L11.5 7L8 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .help-section {
    background: #FFF28C;
    padding: 96px 80px;
  }
  .help-inner { max-width: 1200px; margin: 0 auto; }

  .help-title {
    font-size: clamp(40px, 5.5vw, 80px);
    font-weight: 800;
    color: #1E1E1E;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 72px;
    text-align: center;
  }

  .help-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
  }

  .help-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
  }

  .help-icon {
    width: 160px;
    height: 160px;
    object-fit: contain;
    margin-bottom: 8px;
  }

  .help-card-title {
    font-size: 24px;
    font-weight: 800;
    color: #1E1E1E;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .help-card-desc {
    font-size: 16px;
    color: #444;
    line-height: 1.6;
    flex: 1;
  }

  .help-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 15px;
    font-weight: 600;
    color: #1E1E1E;
    text-decoration: underline;
    text-decoration-color: rgba(30,30,30,0.3);
    text-underline-offset: 3px;
    transition: text-decoration-color .15s;
  }
  .help-link:hover { text-decoration-color: #1E1E1E; }

  @media (max-width: 768px) {
    .help-section { padding: 64px 24px; }
    .help-grid { grid-template-columns: 1fr; gap: 40px; max-width: 420px; margin: 0 auto; }
  }
</style>
