---
const cards = [
  {
    icon: "https://aleluya.com/wp-content/uploads/2025/02/icono-compara-aleluya-2.png",
    title: "Compara Aleluya",
    desc: "Mira cómo se compara Aleluya con otras herramientas de nómina del mercado colombiano.",
    cta: "Ver comparativo",
    href: "https://aleluya.com/precios/",
  },
  {
    icon: "https://aleluya.com/wp-content/uploads/2025/02/icono-tour-aleluya.png",
    title: "Tour de demo",
    desc: "Recorre la plataforma por tu cuenta en 1 minuto. Sin registrarte. Sin compromisos.",
    cta: "Ver demo",
    href: "https://app.storylane.io/share/xquhuzquh4zf",
  },
  {
    icon: "https://aleluya.com/wp-content/uploads/2025/02/icono-centro-de-ayuda-2.png",
    title: "Centro de ayuda",
    desc: "Guías paso a paso para todo lo que necesites: liquidar, configurar, migrar y más.",
    cta: "Ir al centro de ayuda",
    href: "https://ayuda.aleluya.com/portal/es/kb",
  },
];
---

<section class="help-section">
  <div class="help-inner">
    <div class="help-header">
      <h2 class="help-title">¿Querés saber más antes de empezar?</h2>
      <p class="help-subtitle">Tenemos todo lo que necesitás para tomar la decisión con información.</p>
    </div>
    <div class="help-grid">
      {cards.map((card) => (
        <a href={card.href} target="_blank" class="help-card">
          <div class="help-icon-wrap">
            <img src={card.icon} alt={card.title} loading="lazy" />
          </div>
          <h3>{card.title}</h3>
          <p>{card.desc}</p>
          <span class="help-link">
            {card.cta}
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path d="M2.5 7H11.5M8 3.5L11.5 7L8 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .help-section {
    padding: 80px 24px;
    background: #f9f8ff;
  }
  .help-inner { max-width: 1200px; margin: 0 auto; }
  .help-header { text-align: center; margin-bottom: 48px; }
  .help-title {
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 800;
    color: #1E1E1E;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }
  .help-subtitle { font-size: 16px; color: #666; }
  .help-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .help-card {
    background: #fff;
    border: 1px solid #ede8ff;
    border-radius: 20px;
    padding: 32px 28px;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .help-card:hover {
    box-shadow: 0 8px 32px rgba(94, 37, 255, 0.12);
    transform: translateY(-3px);
  }
  .help-icon-wrap {
    width: 72px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 4px;
  }
  .help-icon-wrap img { width: 100%; height: 100%; object-fit: contain; }
  .help-card h3 { font-size: 18px; font-weight: 700; color: #1E1E1E; }
  .help-card p { font-size: 14px; color: #777; line-height: 1.6; flex: 1; }
  .help-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 700;
    color: #5E25FF;
    margin-top: 4px;
  }

  @media (max-width: 768px) {
    .help-grid { grid-template-columns: 1fr; max-width: 440px; margin: 0 auto; }
  }
</style>
